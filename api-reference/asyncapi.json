{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Aura Realtime Stream",
    "version": "2.0.0",
    "description": "Durable Aura market and account events over fetch-based Server-Sent Events. An rt2 cursor is a vector over the active main, sequencer, and wallet sources advertised by protocol config. Request schemaVersion=2 and one or more comma-separated topics. Resume by sending the opaque cursor in the Last-Event-ID header. Credentials are headers or an HttpOnly cookie, never query parameters. Delivery is at least once; deduplicate the semantic event id. An aura-reset frame requires replacing state from a fresh REST snapshot.",
    "contact": {
      "name": "Aura",
      "url": "https://docs.aura.markets"
    }
  },
  "servers": {
    "mainnet": {
      "host": "api.aura.markets",
      "protocol": "https",
      "description": "Production Aura API."
    },
    "testnet": {
      "host": "api.testnet.aura.markets",
      "protocol": "https",
      "description": "Testnet Aura API."
    }
  },
  "channels": {
    "realtimeStream": {
      "address": "/v1/realtime/stream",
      "title": "Schema-v2 realtime SSE",
      "description": "Pass schemaVersion=2 and comma-separated topics. Public examples: market:{marketId}:book, market:{marketId}:trades, market:{marketId}:lifecycle, markets:all, trades:all and book-ticker:all. Private examples: user:{address}:orders, user:{address}:funding, user:{address}:settlements and user:{address}:account. Private semantic types include deposit.*, withdrawal.*, custody.transaction_changed, spendable_balance.changed, position.changed, claimable_balance.changed, reward.changed and payout.changed. Read authoritative topics, sources and replay floors from /v1/protocol/config.",
      "messages": {
        "auraEvent": { "$ref": "#/components/messages/auraEvent" },
        "auraReset": { "$ref": "#/components/messages/auraReset" },
        "auraError": { "$ref": "#/components/messages/auraError" },
        "heartbeat": { "$ref": "#/components/messages/heartbeat" }
      }
    }
  },
  "operations": {
    "subscribe": {
      "action": "receive",
      "channel": { "$ref": "#/channels/realtimeStream" },
      "title": "Receive durable Aura events",
      "summary": "Snapshot, subscribe after the snapshot rt2 cursor, and resynchronize explicitly on reset.",
      "messages": [
        { "$ref": "#/channels/realtimeStream/messages/auraEvent" },
        { "$ref": "#/channels/realtimeStream/messages/auraReset" },
        { "$ref": "#/channels/realtimeStream/messages/auraError" },
        { "$ref": "#/channels/realtimeStream/messages/heartbeat" }
      ]
    }
  },
  "components": {
    "messages": {
      "auraEvent": {
        "name": "aura",
        "title": "Semantic event",
        "summary": "A durable source event with one or more stream memberships.",
        "description": "The SSE id line is the opaque source-vector cursor. The payload id is a stable source-qualified identity used for deduplication. Apply the event durably before checkpointing its cursor.",
        "contentType": "application/json",
        "payload": { "$ref": "#/components/schemas/realtimeEvent" },
        "examples": [
          {
            "name": "Order accepted",
            "payload": {
              "schemaVersion": 2,
              "id": "sequencer:generation-1:184392:0",
              "type": "order.accepted",
              "occurredAt": "2026-08-10T20:00:00.000Z",
              "stream": "market:abc123:book",
              "streams": [
                { "stream": "market:abc123:book", "sequence": "981" },
                { "stream": "user:3CefExample:orders", "sequence": "44" }
              ],
              "source": {
                "name": "sequencer",
                "generation": "generation-1",
                "sequence": "184392",
                "ordinal": 0,
                "hash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
              },
              "cursor": "rt2.eyJ2IjoyLCJzb3VyY2VzIjp7InNlcXVlbmNlciI6eyJnZW5lcmF0aW9uIjoiZ2VuZXJhdGlvbi0xIiwic2VxdWVuY2UiOiIxODQzOTIiLCJvcmRpbmFsIjowLCJoYXNoIjoiMDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWYwMTIzNDU2Nzg5YWJjZGVmMDEyMzQ1Njc4OWFiY2RlZiJ9fX0",
              "marketId": "abc123",
              "orderId": "order-123",
              "bookVersion": "981",
              "data": {
                "quantityBaseUnits": "1000000000000000000",
                "side": "buy"
              }
            }
          }
        ]
      },
      "auraReset": {
        "name": "aura-reset",
        "title": "Replay reset",
        "summary": "The prior cursor cannot safely continue the local snapshot.",
        "description": "Fetch and install a fresh snapshot, then reconnect after that snapshot's cursor. Merely adopting currentCursor leaves stale state in memory.",
        "contentType": "application/json",
        "payload": { "$ref": "#/components/schemas/realtimeReset" }
      },
      "auraError": {
        "name": "aura-error",
        "title": "Stream error",
        "summary": "A typed mid-stream error with a recovery hint.",
        "contentType": "application/json",
        "payload": { "$ref": "#/components/schemas/realtimeError" }
      },
      "heartbeat": {
        "name": "heartbeat",
        "title": "Heartbeat comment",
        "summary": "An SSE comment sent every 15 seconds.",
        "description": "Comments begin with ': heartbeat' and have no JSON payload.",
        "contentType": "text/plain"
      }
    },
    "schemas": {
      "decimalSequence": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "generation", "sequence", "ordinal", "hash"],
        "properties": {
          "name": { "type": "string", "enum": ["main", "sequencer", "wallet"] },
          "generation": { "type": "string" },
          "sequence": { "$ref": "#/components/schemas/decimalSequence" },
          "ordinal": { "type": "integer", "minimum": 0 },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "membership": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream", "sequence"],
        "properties": {
          "stream": { "type": "string" },
          "sequence": { "$ref": "#/components/schemas/decimalSequence" }
        }
      },
      "realtimeEvent": {
        "type": "object",
        "required": ["schemaVersion", "id", "type", "occurredAt", "stream", "streams", "source", "cursor", "data"],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 2 },
          "id": { "type": "string", "description": "source:generation:sequence:ordinal" },
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
          "occurredAt": { "type": "string", "format": "date-time" },
          "stream": { "type": "string" },
          "streams": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/membership" } },
          "source": { "$ref": "#/components/schemas/source" },
          "cursor": { "type": "string", "pattern": "^rt2\\." },
          "marketId": { "type": "string" },
          "accountId": { "type": "string" },
          "orderId": { "type": "string" },
          "matchId": { "type": "string" },
          "settlementId": { "type": "string" },
          "bookVersion": { "$ref": "#/components/schemas/decimalSequence" },
          "accountVersion": { "$ref": "#/components/schemas/decimalSequence" },
          "data": {
            "type": "object",
            "description": "Semantic payload. Every numeric protocol value is encoded as a decimal string; JSON numbers are forbidden recursively. See the realtime guide for exact private deposit, withdrawal, custody, spendable, position, claimable, reward and payout payload unions."
          }
        }
      },
      "realtimeReset": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "type", "reason", "requestedCursor", "currentCursor", "sources", "occurredAt"],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 2 },
          "type": { "type": "string", "const": "replay.reset" },
          "reason": {
            "type": "string",
            "enum": ["retention-exceeded", "generation-changed", "replay-limit-exceeded", "source-restored"]
          },
          "requestedCursor": { "type": ["string", "null"] },
          "currentCursor": { "type": "string", "pattern": "^rt2\\." },
          "sources": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["main", "sequencer", "wallet"] } },
          "occurredAt": { "type": "string", "format": "date-time" }
        }
      },
      "realtimeError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "type", "code", "message", "requestId", "recoverable", "lastCursor", "occurredAt"],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 2 },
          "type": { "type": "string", "const": "stream.error" },
          "code": {
            "type": "string",
            "enum": [
              "slow_consumer",
              "replay_unavailable",
              "session_expired",
              "session_revoked",
              "session_revalidation_unavailable",
              "developer_key_revoked",
              "developer_key_expired",
              "developer_key_rotated",
              "developer_key_scope_changed",
              "developer_key_generation_changed",
              "developer_key_revalidation_unavailable",
              "source_unavailable"
            ]
          },
          "message": { "type": "string" },
          "requestId": { "type": "string" },
          "recoverable": { "type": "boolean" },
          "lastCursor": { "type": ["string", "null"] },
          "occurredAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
