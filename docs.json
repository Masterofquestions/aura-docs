{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Aura",
  "description": "Decentralized prediction markets on Alephium. User docs, governance specs, and the public REST API.",
  "colors": {
    "primary": "#8B5CF6",
    "light": "#A78BFA",
    "dark": "#7C3AED"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://aura.markets"
  },
  "background": {
    "color": {
      "light": "#FAFAFA",
      "dark": "#0A0A0F"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "overview/introduction",
              "overview/why-alephium",
              "getting-started/connecting",
              "getting-started/bridging",
              "getting-started/passkeys"
            ]
          },
          {
            "group": "Markets",
            "pages": [
              "markets/overview",
              "markets/trading",
              "markets/creating-markets",
              "markets/resolution-and-disputes"
            ]
          },
          {
            "group": "Tokens & Staking",
            "pages": [
              "tokens/aura",
              "tokens/staking",
              "tokens/tier-structure",
              "tokens/alph"
            ]
          },
          {
            "group": "Governance",
            "pages": [
              "governance/proposal-voting",
              "governance/outcome-voting"
            ]
          },
          {
            "group": "Programs",
            "pages": [
              "programs/overview",
              "programs/creator-rewards",
              "programs/liquidity-rewards",
              "programs/referral-program",
              "programs/dispute-rewards"
            ]
          },
          {
            "group": "Tutorials",
            "pages": [
              "tutorials/user-tutorials",
              "tutorials/strategies",
              "tutorials/binary-market-best-practices",
              "tutorials/categorical-market-best-practices",
              "tutorials/maximizing-tier-benefits",
              "tutorials/voting-on-disputes"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/contracts",
              "resources/security",
              "resources/error-codes",
              "overview/roadmap"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "support/faq",
              "support/contact"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "api-reference/introduction",
              "api-reference/quickstart",
              "api-reference/place-your-first-order"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "api-reference/authentication",
              "api-reference/build-tx-flow",
              "api-reference/realtime",
              "api-reference/rate-limits",
              "api-reference/integrator-guide"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "api-reference/errors"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "/api-reference/openapi.json",
              "directory": "api-reference"
            }
          },
          {
            "group": "Realtime Stream",
            "asyncapi": {
              "source": "/api-reference/asyncapi.json",
              "directory": "api-reference"
            }
          }
        ]
      },
      {
        "tab": "Changelog",
        "groups": [
          {
            "group": "Changelog",
            "pages": [
              "changelog"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/markets/rewards-and-incentives",
      "destination": "/programs/overview"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode",
      "download-spec"
    ]
  },
  "api": {
    "examples": {
      "languages": ["bash", "javascript", "python", "go"],
      "defaults": "required"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "Aura",
      "og:type": "website",
      "og:locale": "en_US",
      "twitter:card": "summary_large_image",
      "twitter:site": "@AuraMarkets",
      "canonical": "https://docs.aura.markets"
    },
    "organization": {
      "id": "https://aura.markets/#organization",
      "name": "Aura",
      "url": "https://aura.markets",
      "sameAs": [
        "https://x.com/AuraMarkets",
        "https://t.me/AuraMarkets"
      ]
    }
  },
  "metadata": {
    "timestamp": true
  },
  "navbar": {
    "links": [
      {
        "label": "Telegram",
        "href": "https://t.me/AuraMarkets"
