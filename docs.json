          { "label": "Create a market", "href": "https://docs.aura.markets/markets/creating-markets" },
          { "label": "Fund your account", "href": "https://docs.aura.markets/getting-started/bridging" }
        ]
      },
      {
        "header": "Earn",
        "items": [
          { "label": "Creator rewards", "href": "https://docs.aura.markets/programs/creator-rewards" },
          { "label": "Liquidity rewards", "href": "https://docs.aura.markets/programs/liquidity-rewards" },
          { "label": "Referral program", "href": "https://docs.aura.markets/programs/referral-program" },
          { "label": "Dispute voting", "href": "https://docs.aura.markets/programs/dispute-rewards" }
        ]
      },
      {
        "header": "Build",
        "items": [
          { "label": "API reference", "href": "https://docs.aura.markets/api-reference/introduction" },
          { "label": "Your first API call", "href": "https://docs.aura.markets/api-reference/quickstart" },
          { "label": "Realtime data", "href": "https://docs.aura.markets/api-reference/realtime" },
          { "label": "Changelog", "href": "https://docs.aura.markets/changelog" }
        ]
      },
      {
        "header": "Security",
        "items": [
          { "label": "Contracts", "href": "https://docs.aura.markets/resources/contracts" },
